# Copy to .env.local for development, and set the same names in Vercel.
# Never commit real values: .env.local stays ignored.

# --- Supabase -----------------------------------------------------------
# Both reach the browser on purpose: the publishable key is safe to expose,
# row level security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Card generation ----------------------------------------------------
# Server only. Read by the Anthropic SDK itself, not through process.env.
ANTHROPIC_API_KEY=

# --- Images -------------------------------------------------------------
# recraft (default) or cloudflare
IMAGE_PROVIDER=recraft

# Recraft is prepaid, so a spent balance stops generation instead of billing.
RECRAFT_API_KEY=
# Optional. A custom style built from reference images. Without it the
# provider falls back to a worded style, which holds the look less well.
RECRAFT_STYLE_ID=

# Only needed when IMAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Quota --------------------------------------------------------------
# The auth.users id that generates without a limit. Everyone else gets
# GUEST_LIMIT new words. Unset means everyone is a guest, including you.
OWNER_USER_ID=
